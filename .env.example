# =============================================================================
# Jarvis configuration — copy to .env and fill in.
# =============================================================================

# --- LLM (brain) ---
# Primary: OpenAI
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini

# Fallback: local Ollama (optional, only used if OPENAI is unreachable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_ENABLED=false

# --- TTS (voice) ---
# Primary: ElevenLabs
ELEVENLABS_API_KEY=REPLACE_ME
# "Adam" voice by default — JARVIS-ish British male. Change to any voice_id you like.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Fallback: local pyttsx3 (always available, robotic)
TTS_FALLBACK=pyttsx3

# --- STT (ears) ---
# whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base.en
# Device: cpu | cuda
WHISPER_DEVICE=cpu

# --- Wake word ---
# openwakeword model name. "hey_jarvis" is the built-in community model.
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5

# --- Audio ---
# Input / output device indices. Leave blank to use system default.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000

# --- Memory ---
# SQLite path (easy default). Swap to Postgres URL for production.
DATABASE_URL=sqlite:///data/jarvis.db
CHROMA_PERSIST_DIR=data/chroma_db
MEMORY_SHORT_TERM_WINDOW=20
MEMORY_IMPORTANCE_THRESHOLD=0.35

# --- Identity / personality ---
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=Sir
JARVIS_PERSONALITY=crisp_british_butler

# --- Server (for future mobile / remote access) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
SERVER_API_KEY=change-me-to-a-long-random-string

# --- Safety ---
# Require confirmation before destructive actions
REQUIRE_CONFIRM_DESTRUCTIVE=true
# Log every action for audit
AUDIT_LOG=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
